# =============================================================
#  MADEE — Variables d'environnement
#  Copiez ce fichier en « .env.local » pour le développement
#  local, et ajoutez les mêmes clés dans Vercel (Settings →
#  Environment Variables) pour la production.
#
#  👉 Tant qu'aucune clé n'est renseignée, le site fonctionne
#     en MODE SIMULATION : le tunnel d'achat marche mais aucun
#     paiement réel n'est débité. Idéal pour tester la boutique.
# =============================================================

# URL publique du site (sans / final).
# En local : http://localhost:3000 — sur Vercel, mettez votre domaine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------------------------
#  STRIPE — https://dashboard.stripe.com/apikeys
#  Utilisez d'abord les clés de TEST (commencent par sk_test_ /
#  pk_test_) puis les clés « live » pour encaisser réellement.
# -------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -------------------------------------------------------------
#  PAYPAL — https://developer.paypal.com/dashboard/applications
#  PAYPAL_ENV : « sandbox » pour tester, « live » en production.
# -------------------------------------------------------------
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
